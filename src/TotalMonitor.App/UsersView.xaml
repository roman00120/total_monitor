<UserControl x:Class="TotalMonitor.App.UsersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel><TextBlock Text="Administración de usuarios" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding Message}" Foreground="#627D98" Margin="0,10,0,16"/><ListView ItemsSource="{Binding Users}"><ListView.View><GridView><GridViewColumn Header="USUARIO" DisplayMemberBinding="{Binding UserName}" Width="180"/><GridViewColumn Header="NOMBRE" DisplayMemberBinding="{Binding DisplayName}" Width="200"/><GridViewColumn Header="ESTADO" DisplayMemberBinding="{Binding IsActive}" Width="100"/><GridViewColumn Header="ÚLTIMO ACCESO" DisplayMemberBinding="{Binding LastLoginAt}" Width="180"/></GridView></ListView.View></ListView></StackPanel></UserControl>
