<UserControl x:Class="TotalMonitor.App.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="0,0,0,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="Generación de Reportes de Monitoreo" FontSize="20" FontWeight="SemiBold" Foreground="#102A43"/>
      <TextBlock Text="Genere resúmenes tabulares y exportaciones CSV de las mediciones persistidas en MySQL."
                 Foreground="#627D98" Margin="0,4,0,0"/>
    </StackPanel>

    <!-- Control Panel -->
    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16"
            BorderBrush="#CBD2D9" BorderThickness="1">
      <StackPanel>
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,12,0">
            <TextBlock Text="Fecha Inicial" FontWeight="Medium" Foreground="#334E68" Margin="0,0,0,4"/>
            <DatePicker SelectedDate="{Binding FromDate}" Height="32"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,12,0">
            <TextBlock Text="Fecha Final" FontWeight="Medium" Foreground="#334E68" Margin="0,0,0,4"/>
            <DatePicker SelectedDate="{Binding ToDate}" Height="32"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
            <Button Content="GENERAR REPORTE" Command="{Binding GenerateCommand}"
                    Background="#16B8A6" Foreground="White" FontWeight="SemiBold"
                    Padding="16,0" Height="32" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand"/>
            <Button Content="EXPORTAR CSV" Command="{Binding ExportCommand}"
                    Background="#243B53" Foreground="White" FontWeight="SemiBold"
                    Padding="16,0" Height="32" BorderThickness="0" Cursor="Hand"/>
          </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Filtros rápidos:" VerticalAlignment="Center" Foreground="#627D98" Margin="0,0,8,0" FontWeight="Medium"/>
          <Button Content="Hoy" Command="{Binding TodayCommand}" Background="#E2E8F0" Foreground="#243B53"
                  Padding="10,4" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"/>
          <Button Content="Ayer" Command="{Binding YesterdayCommand}" Background="#E2E8F0" Foreground="#243B53"
                  Padding="10,4" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"/>
          <Button Content="Últimos 7 días" Command="{Binding Last7DaysCommand}" Background="#E2E8F0" Foreground="#243B53"
                  Padding="10,4" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>

        <TextBlock Text="{Binding Message}" Foreground="#627D98" Margin="0,10,0,0" FontWeight="Medium" FontSize="12"/>
      </StackPanel>
    </Border>

    <!-- Results Table -->
    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="16" BorderBrush="#CBD2D9" BorderThickness="1">
      <ListView ItemsSource="{Binding Results}" VirtualizingPanel.IsVirtualizing="True" MinHeight="250">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="FECHA / HORA" DisplayMemberBinding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="160"/>
            <GridViewColumn Header="MEDIDOR" DisplayMemberBinding="{Binding MeterName}" Width="180"/>
            <GridViewColumn Header="VARIABLE" DisplayMemberBinding="{Binding Variable}" Width="180"/>
            <GridViewColumn Header="VALOR" DisplayMemberBinding="{Binding Value, StringFormat='{}{0:0.##}'}" Width="120"/>
            <GridViewColumn Header="UNIDAD" DisplayMemberBinding="{Binding Unit}" Width="90"/>
          </GridView>
        </ListView.View>
      </ListView>
    </Border>
  </Grid>
</UserControl>
